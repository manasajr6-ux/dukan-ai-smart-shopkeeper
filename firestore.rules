rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.userId == request.auth.uid
        && data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 100
        && data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming())
        && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Product Validation
    function isValidProduct(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.category is string && data.category.size() <= 50
        && data.costPrice is number && data.costPrice >= 0
        && data.sellingPrice is number && data.sellingPrice >= 0
        && data.stockQuantity is number
        && data.minStockThreshold is number && data.minStockThreshold >= 0
        && data.unit is string && data.unit.size() <= 20;
    }

    match /products/{productId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Sales Validation
    function isValidSale(data) {
      return data.userId == request.auth.uid
        && data.billNumber is string && data.billNumber.size() <= 50
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentMode is string && data.paymentMode.size() <= 30
        && data.paymentStatus is string && data.paymentStatus.size() <= 30;
    }

    match /sales/{saleId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isSignedIn() && isValidId(saleId) && isValidSale(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
